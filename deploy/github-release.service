[Unit]
Description=Allowlisted GitHub Release metadata and APK cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/github-release
ExecStart=/usr/bin/python3 /opt/github-release/release_proxy.py
Environment=PORT=3043
Environment=GITHUB_RELEASE_REPOSITORIES=string1225/star-collect
Environment=GITHUB_RELEASE_PUBLIC_BASE=https://home.sunny-string.cn
Environment=GITHUB_RELEASE_CACHE=/var/lib/github-release
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost
StateDirectory=github-release
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
